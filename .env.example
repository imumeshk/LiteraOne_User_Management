PORT=3000
SESSION_SECRET=replace-with-a-strong-random-value
SESSION_COOKIE_SECURE=false

# Microsoft SSO settings (app registration in Entra)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Enablement Hub admin login (for backend config management endpoints)
ENABLEMENT_ADMIN_USERNAME=enablement_admin
ENABLEMENT_ADMIN_PASSWORD=change-me-strong-password
ENABLEMENT_ADMIN_LOGIN_URL=http://localhost:3000/enablement-admin-login

# Optional path to enablement hub config JSON (default: ./enablement-hub.json)
# ENABLEMENT_HUB_CONFIG_PATH=enablement-hub.json
