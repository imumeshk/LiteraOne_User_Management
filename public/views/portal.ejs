      <div class="inp-group mb-2">
        <span class="inp-icon">🔍</span>
        <input class="inp" id="scimAssignInput" placeholder="Search users or groups..." oninput="searchScimAssignables()"/>
      </div>
      <label class="chk-label mb-2">
        <input type="checkbox" id="scimSelectAllResults" onchange="toggleSelectAllResults('scim', this)">
        Select all results shown
