        <button class="btn btn-secondary" type="button" onclick="testScimConnection()">Test Connection</button>
        <div id="scimTestResult" class="text-xs" style="margin-top:8px"></div>
      </div>
    </div>
    <!-- Step 3 -->
    <div id="scimPane3" style="display:none">
      <div class="section-label">Add initial users/groups <span style="font-weight:400">(optional)</span></div>
