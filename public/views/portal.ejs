      <div id="scimAssignCopyRow" class="flex gap-2 items-center mb-2" style="display:none">
        <select class="inp inp-sm" id="scimAssignCopySourceApp" style="flex:1"></select>
        <button class="btn btn-secondary btn-sm" type="button" onclick="copyAssignmentsIntoSelection('scim')">Copy</button>
