  window.__INITIAL_PAGE__ = "<%= initialPage || 'dashboard' %>";
  window.__STANDALONE_ENABLEMENT_ADMIN__ = <%= standaloneEnablementAdmin ? 'true' : 'false' %>;
  window.__IS_AUTHENTICATED__ = <%= isAuthenticated ? 'true' : 'false' %>;
  window.__CSRF_TOKEN__ = "<%= csrfToken || '' %>";
</script>
<script src="/js/portal.js"></script>
</body>
</html>
